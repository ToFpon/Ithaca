[Desktop Entry]
Type=Application
Name=Ithaca
GenericName=Music Player
GenericName[fr]=Lecteur de musique
GenericName[de]=Musikwiedergabe
Comment=Play your music, and nothing else
Comment[fr]=Écouter votre musique, et rien d'autre
Comment[de]=Ihre Musik abspielen, und sonst nichts
Exec=ithaca %U
Icon=io.github.ithaca.Ithaca
Terminal=false
Categories=GTK;GNOME;AudioVideo;Audio;Player;
Keywords=music;audio;player;song;playlist;mp3;flac;
Keywords[fr]=musique;audio;lecteur;morceau;chanson;liste;mp3;flac;
Keywords[de]=Musik;Audio;Wiedergabe;Lied;Playlist;mp3;flac;
StartupNotify=true
DBusActivatable=true
StartupWMClass=io.github.ithaca.Ithaca
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/aac;audio/x-wav;audio/x-wavpack;audio/x-ape;audio/x-musepack;audio/x-aiff;audio/x-ms-wma;audio/x-matroska;inode/directory;

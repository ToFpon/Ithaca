#: ithaca/features.py:25
msgid "Barre en forme d'onde"
msgstr "Wellenform-Leiste"

#: ithaca/features.py:26
msgid "La barre de progression dessine la forme d'onde du morceau (calculée une fois, gardée en cache)"
msgstr "Die Fortschrittsleiste zeigt die Wellenform des Titels (einmal berechnet, zwischengespeichert)"

#: ithaca/features.py:28
msgid "Contrôle depuis le système"
msgstr "Steuerung durch das System"

#: ithaca/features.py:29
msgid "Panneau de GNOME, écran verrouillé et touches multimédia du clavier (MPRIS)"
msgstr "GNOME-Leiste, Sperrbildschirm und Medientasten der Tastatur (MPRIS)"

#: ithaca/features.py:31 ithaca/ui/window.py:202
msgid "Lecture en arrière-plan"
msgstr "Wiedergabe im Hintergrund"


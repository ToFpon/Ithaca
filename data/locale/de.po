#: ithaca/features.py:25
msgid "Barre en forme d'onde"
msgstr "Wellenform-Leiste"

#: ithaca/features.py:26
msgid ""
"La barre de progression dessine la forme d'onde du morceau (calculée une "
"fois, gardée en cache)"
msgstr ""
"Die Fortschrittsleiste zeigt die Wellenform des Titels (einmal berechnet, "
"zwischengespeichert)"

